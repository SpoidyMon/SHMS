generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id        Int      @id @default(autoincrement())
  username  String?
  email     String   @unique
  mobileNo  String //@unique not for now
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role

  hashedpassword String?
  isActive       Boolean    @default(true)
  status         UserStatus @default(INVITED)
  verified       Boolean    @default(false) @map("Verified")

  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  // staff management
  tokenVersion  Int       @default(0) // bump to invalidate old JWTs
  createdById   Int? // which admin created this staff
  deactivatedAt DateTime?
  deletedAt     DateTime?
  otps          otp[]
}

model otp {
  id        Int       @id @default(autoincrement())
  otphash   String
  createdAt DateTime  @default(now())
  userId    Int
  expiresAt DateTime?
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  // USER
  ADMIN
  SUPERVISOR
  MANAGER
  CHEF
  WAITER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

//Menu Management

model Category {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  displayOrder Int //admin can control the order items customer can see
  isActive     Boolean // to mark unavaibale as for temporeary/permanent
  menuItems    MenuItem[]
}

model MenuItem {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  price       Int
  image       String
  category    Category  @relation(fields: [categoryId], references: [id])
  isVeg       VegNonveg
  isDeleted   Boolean   @default(false)
  isAvailable Boolean   @default(true) //controlled by chef 
  categoryId  Int
}

enum VegNonveg {
  VegNon
  NONVEG
}

enum MenuGroups {
  Starters
  Main_Course
  Drinks
  Desserts
}
